#!/usr/bin/env python3
"""Power information and session-scoped KDE keep-awake control."""
import argparse
import json
import signal
import subprocess
import sys
import os
from pathlib import Path

NAME = 'com.columbiafoundry.komapowercontrol.Plaid'
UNIT = 'komapowercontrol-plaid.service'

def battery_info(props):
    present = bool(props.get('IsPresent', False)) and int(props.get('Type', 0)) in (2, 3)
    state = int(props.get('State', 0))
    return dict(present=present, percent=max(0, min(100, float(props.get('Percentage', 0)))),
                status={1: 'Charging', 2: 'Discharging', 3: 'Empty', 4: 'Fully charged',
                        5: 'Waiting to charge', 6: 'Waiting to discharge'}.get(state, 'AC power'),
                capacity=float(props.get('EnergyFull', 0)), rate=float(props.get('EnergyRate', 0)),
                seconds=int(props.get('TimeToFull' if state == 1 else 'TimeToEmpty', 0)),
                cycles=int(props.get('ChargeCycles', -1)))

def profile_proxy(bus):
    import dbus
    for name, path in [('org.freedesktop.UPower.PowerProfiles', '/org/freedesktop/UPower/PowerProfiles'),
                       ('net.hadess.PowerProfiles', '/net/hadess/PowerProfiles')]:
        if bus.name_has_owner(name):
            return dbus.Interface(bus.get_object(name, path), 'org.freedesktop.DBus.Properties'), name
    return None, None

def status():
    import dbus
    session, system = dbus.SessionBus(), dbus.SystemBus()
    result = dict(battery=battery_info({}), plaid=bool(session.name_has_owner(NAME)),
                  profiles=[], activeProfile='', error='')
    try:
        up = dbus.Interface(system.get_object('org.freedesktop.UPower', '/org/freedesktop/UPower'), 'org.freedesktop.UPower')
        path = up.GetDisplayDevice()
        props = dbus.Interface(system.get_object('org.freedesktop.UPower', path), 'org.freedesktop.DBus.Properties')
        result['battery'] = battery_info(props.GetAll('org.freedesktop.UPower.Device'))
    except dbus.DBusException as exc:
        result['error'] = 'Battery information unavailable: ' + str(exc)
    proxy, interface = profile_proxy(system)
    if proxy:
        result['profiles'] = [str(p['Profile']) for p in proxy.Get(interface, 'Profiles')]
        result['activeProfile'] = str(proxy.Get(interface, 'ActiveProfile'))
    return result

def hold():
    import dbus
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    policy = dbus.Interface(bus.get_object('org.kde.Solid.PowerManagement', '/org/kde/Solid/PowerManagement/PolicyAgent'), 'org.kde.Solid.PowerManagement.PolicyAgent')
    saver = dbus.Interface(bus.get_object('org.freedesktop.ScreenSaver', '/ScreenSaver'), 'org.freedesktop.ScreenSaver')
    cookie = lock_cookie = None
    loop = GLib.MainLoop()
    try:
        cookie = policy.AddInhibition(5, 'kOMA Power Control', 'PLAID Power: keep the machine and screens awake')
        lock_cookie = saver.Inhibit('kOMA Power Control', 'PLAID Power')
        owner = dbus.service.BusName(NAME, bus=bus, do_not_queue=True)
        def stop(*args):
            loop.quit()
            return False
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)
        def owner_changed(name, old, new):
            if str(name) in ('org.kde.Solid.PowerManagement', 'org.freedesktop.ScreenSaver') and old and old != new:
                loop.quit()
        bus.add_signal_receiver(owner_changed, signal_name='NameOwnerChanged', dbus_interface='org.freedesktop.DBus', bus_name='org.freedesktop.DBus')
        loop.run()
    finally:
        for proxy, method, token in [(saver, 'UnInhibit', lock_cookie), (policy, 'ReleaseInhibition', cookie)]:
            if token is not None:
                try:
                    getattr(proxy, method)(token)
                except dbus.DBusException:
                    pass

def ensure_service():
    """Store installs include the helper but do not run bin/install."""
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    unit = config / 'systemd/user' / UNIT
    helper = str(Path(__file__).resolve()).replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%')
    body = ('[Unit]\nDescription=kOMA PLAID Power keep-awake override\n'
            'PartOf=graphical-session.target\nAfter=graphical-session.target\n\n'
            '[Service]\nType=dbus\nBusName=' + NAME + '\n'
            'ExecStart=/usr/bin/python3 "' + helper + '" hold\n'
            'Restart=on-failure\nRestartSec=2\nTimeoutStartSec=15\nTimeoutStopSec=10\n')
    if not unit.exists() or unit.read_text() != body:
        unit.parent.mkdir(parents=True, exist_ok=True)
        unit.write_text(body)
        subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True, timeout=20, capture_output=True, text=True)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('status')
    sub.add_parser('hold')
    p = sub.add_parser('plaid'); p.add_argument('mode', choices=['on', 'off'])
    p = sub.add_parser('profile'); p.add_argument('name', choices=['power-saver', 'balanced', 'performance'])
    args = parser.parse_args()
    try:
        if args.command == 'hold':
            hold(); return
        if args.command == 'plaid':
            if args.mode == 'on':
                ensure_service()
            subprocess.run(['systemctl', '--user', 'start' if args.mode == 'on' else 'stop', UNIT], check=True, timeout=20, capture_output=True, text=True)
        if args.command == 'profile':
            import dbus
            proxy, interface = profile_proxy(dbus.SystemBus())
            if not proxy or args.name not in [str(p['Profile']) for p in proxy.Get(interface, 'Profiles')]:
                raise RuntimeError('This power profile is unavailable on this machine.')
            proxy.Set(interface, 'ActiveProfile', dbus.String(args.name))
        print(json.dumps(status()))
    except Exception as exc:
        detail = getattr(exc, 'stderr', '') or str(exc)
        print(json.dumps({'error': detail.strip()}))
        return 1

if __name__ == '__main__':
    sys.exit(main())
